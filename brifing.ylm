.github/workflows/brifing.yml
# Her 2 saatte bir, Türkiye saatiyle 08:00-22:00 arası Çalar (Ücretsiz).
# Repo > Settings > Secrets and variables > Actions bÃ¶lÃ¼mÃ¼ne 3 secret ekle:
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, GEMINI_API_KEY
isim: Haber Brifingi
Açık:
  takvim:
    # UTC: 05,07,...,19 = Türkiye: 08,10,...,22 (GitHub birkaş dakika geciktirebilir)
    - cron: "0 5,7,9,11,13,15,17,19 * * *"
  workflow_dispatch: # elle de Çalabilirsiniz
İşler:
  brifing:
    runs-on: ubuntu-latest
    Adımlar:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        ile:
          python-sürümü: "3.12"
      - isim: Daha Önce Gündelen haberleri Geri Yükle
        kullanımlar: actions/cache@v4
        ile:
          yol: gorulenler.json
          anahtar: gorulenler-${{ github.run_id }}
          geri yükle: gorulenler-
      - Çalıştır: pip install requests edge-tts
      - Çalıştır: python gunluk_brifing.py
        ortam:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
